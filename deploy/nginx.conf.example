# Replace playstats.example.com and confirm the root before enabling.
server {
    listen 80;
    listen [::]:80;
    server_name playstats.example.com;

    root /var/www/playstats/current;
    index index.html;
    charset utf-8;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    location / {
        try_files $uri $uri/ =404;
    }

    error_page 404 /404.html;
    location = /404.html {
        internal;
    }

    # Next.js content-hashed bundles; other files revalidate after releases.
    location /_next/static/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }
}
